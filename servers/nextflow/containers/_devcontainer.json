{
    "name": "behavior",
    "image": "internationalbrainlab/photometry:nextflow",
    "remoteUser": "ubuntu",
    "workspaceFolder": "/home/ubuntu",
    "mounts": [
        "source=/mnt/s0,target=/mnt/s0,type=bind",
        "source=${localEnv:HOME}/.one,target=/home/ubuntu/.one,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy"
            ]
        }
    }
}