# mbox crontab. Install with:  crontab ~/Documents/PYTHON/iblsre/alyx/hosts/mbox/crontab.cron
#
# Scripts are synced to ~/app/scripts/ by ansible_deploy_alyx.yaml (shared alyx/scripts/ plus
# this host's alyx/hosts/mbox/scripts/); that directory is also mounted read-only into the
# container at /home/scripts by docker-compose.scripts.yaml.
#   host-side script    -> /home/ubuntu/app/scripts/<name>
#   in-container script -> docker exec ibl_alyx_apache ... /home/scripts/<name>

# UCL (cortexlab) import into IBL (host-side: dumps the cortexlab RDS into the buffer postgres)
0 23 * * * /bin/bash -o pipefail -c '/bin/bash /home/ubuntu/app/scripts/ucl_import.sh 2>&1 | tee /var/log/ucl_import.log' && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/45f474e8-ee7a-4b91-b063-4b0a8f8aa75c

# IBL database backup to SDSC (host-side: needs the host's SSH key)
15 0 * * * /bin/bash -o pipefail -c '/bin/bash /home/ubuntu/app/scripts/01_backup_ibl.sh 2>&1 | tee /var/log/alyx_backup.log' && curl -fsS -m 10 --retry 5 -o /dev/null https://hc-ping.com/29e40a02-ea74-4213-9794-fdf1de8af9c9

# Globus file sync, one run per lab time zone (in-container)
0  2 * * * docker exec ibl_alyx_apache /bin/bash /home/scripts/02a_globus_sync_UTC.sh 2>&1 | tee /var/log/alyx_globus.log
0  7 * * * docker exec ibl_alyx_apache /bin/bash /home/scripts/02b_globus_sync_EST.sh 2>&1 | tee -a /var/log/alyx_globus.log
0 10 * * * docker exec ibl_alyx_apache /bin/bash /home/scripts/02c_globus_sync_PT.sh 2>&1 | tee -a /var/log/alyx_globus.log

# ibl-impact metrics collection (not alyx-related)
0 8 * * * /bin/bash -o pipefail -c 'cd /home/ubuntu/Documents/PYTHON/ibl-impact && source /home/ubuntu/.local/bin/env && uv run ibl-impact collect >> /home/ubuntu/Documents/PYTHON/ibl-impact/collect.log 2>&1'
