0 8 * * * /bin/bash -o pipefail -c 'cd /home/ubuntu/Documents/PYTHON/ibl-impact && source /home/ubuntu/.local/bin/env && uv run ibl-impact collect >> /home/ubuntu/Documents/PYTHON/ibl-impact/collect.log 2>&1'
