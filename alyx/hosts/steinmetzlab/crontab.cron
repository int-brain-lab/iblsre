# steinmetzlab crontab. Install as the ubuntu user (NOT root):
#     crontab ~/Documents/PYTHON/iblsre/alyx/hosts/steinmetzlab/crontab.cron
#
# m h  dom mon dow   command
0 2 * * * /home/ubuntu/app/scripts/backup_db.sh
# Renew certificates at 01:30 on the 1st and 15th
30 1 1,15 * * docker exec alyx_apache certbot renew --post-hook "apachectl graceful" > /var/log/alyx/cert_renew.log 2>&1
